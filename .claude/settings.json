{
  "claudeMdExcludes": [
    "/config/.claude/CLAUDE.md",
    "/config/.claude/RTK.md"
  ],
  "permissions": {
    "allow": [
      "SendMessage",
      "ListAgents",
      "Skill"
    ],
    "deny": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Monitor",
      "CronCreate",
      "CronDelete",
      "CronList",
      "RemoteTrigger",
      "ScheduleWakeup",
      "PushNotification",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "TaskStop",
      "Workflow",
      "DesignSync",
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Google_Drive",
      "mcp__claude_ai_Claude_Docs",
      "mcp__claude_ai_GQueues"
    ]
  },
  "disableAllHooks": true,
  "enabledPlugins": {
    "cc-plugin-agents-md@builtin": false
  },
  "enableArtifact": false,
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "remoteControlAtStartup": false
}
